generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workspace {
  id            String          @id
  name          String
  timezone      String          @default("Asia/Manila")
  awayMessage   String          @default("")
  createdAt     DateTime        @default(now())
  channels      ChannelAccount[]
  members       TeamMember[]
  customers     Customer[]
  conversations Conversation[]
  orders        Order[]
  liveSessions  LiveSession[]
  savedReplies  SavedReply[]
  businessHours BusinessHour[]
  invoices      Invoice[]
}

model ChannelAccount {
  id          String   @id @default(cuid())
  workspaceId String
  platform    String
  name        String
  handle      String
  accountType String
  status      String   @default("CONNECTED")
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([workspaceId, platform, handle])
  @@index([workspaceId, status])
}

model TeamMember {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  email       String
  role        String   @default("AGENT")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([workspaceId, email])
}

model Customer {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  handle      String   @default("")
  phone       String   @default("")
  address     String   @default("")
  tags        String   @default("")
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channels    CustomerChannel[]
  conversations Conversation[]
  orders      Order[]

  @@index([workspaceId, name])
}

model CustomerChannel {
  id         String   @id @default(cuid())
  customerId String
  platform   String
  handle     String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, platform, handle])
}

model Conversation {
  id               String   @id @default(cuid())
  workspaceId      String
  customerId       String
  channelAccountId String
  assignedToId     String?
  status           String   @default("OPEN")
  needsReply       Boolean  @default(true)
  tags             String   @default("")
  preview          String   @default("")
  lastMessageAt    DateTime @default(now())
  snoozedUntil     DateTime?
  createdAt        DateTime @default(now())
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channelAccount   ChannelAccount @relation(fields: [channelAccountId], references: [id])
  assignedTo       TeamMember? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  messages         Message[]
  orders           Order[]

  @@index([workspaceId, lastMessageAt])
  @@index([workspaceId, status, needsReply])
}

model Message {
  id           String   @id @default(cuid())
  conversationId String
  direction    String
  body         String
  providerId   String?
  deliveryStatus String @default("LOCAL")
  isRead       Boolean  @default(true)
  createdAt    DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Order {
  id               String   @id @default(cuid())
  workspaceId      String
  customerId       String
  conversationId   String?
  orderNumber      String
  paymentStatus    String   @default("PENDING_PAYMENT")
  fulfillmentStatus String @default("NOT_SHIPPED")
  courier          String   @default("")
  trackingNumber   String   @default("")
  shippingFee      Int      @default(0)
  total            Int
  createdAt        DateTime @default(now())
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer         Customer @relation(fields: [customerId], references: [id])
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items            OrderItem[]

  @@unique([workspaceId, orderNumber])
  @@index([workspaceId, createdAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  name      String
  variant   String @default("")
  quantity  Int    @default(1)
  unitPrice Int
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model LiveSession {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  status      String   @default("ENDED")
  keywords    String   @default("mine,steal")
  startedAt   DateTime?
  endedAt     DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  claims      LiveClaim[]

  @@index([workspaceId, startedAt])
}

model LiveClaim {
  id          String   @id @default(cuid())
  sessionId   String
  customerName String
  customerHandle String @default("")
  productName String
  variant     String   @default("")
  quantity    Int      @default(1)
  comment     String   @default("")
  status      String   @default("CONFIRMED")
  createdAt   DateTime @default(now())
  session     LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model SavedReply {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  shortcut    String
  message     String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, shortcut])
}

model BusinessHour {
  id          String  @id @default(cuid())
  workspaceId String
  weekday     Int
  isClosed    Boolean @default(false)
  opensAt     String  @default("09:00")
  closesAt    String  @default("18:00")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, weekday])
}

model Invoice {
  id          String   @id @default(cuid())
  workspaceId String
  invoiceDate DateTime
  amount      Int
  status      String   @default("PAID")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, invoiceDate])
}
